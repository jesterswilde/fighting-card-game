{
  "name": "fighting-card-game",
  "version": "1.0.0",
  "main": "server/index.ts",
  "author": "Corey Wolff",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@types/cors": "^2.8.4",
    "@types/express": "^4.17.25",
    "@types/lodash": "^4.14.129",
    "@types/socket.io": "^2.1.2",
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "lodash": "^4.17.15",
    "ncp": "^2.0.0",
    "pg": "^7.9.0",
    "pg-connection-string": "^2.0.0",
    "pg-hstore": "^2.3.2",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^2.2.0",
    "typeorm": "^0.2.22"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/bun": "^1.3.0",
    "sass": "^1.93.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.8.0"
  },
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "test": "bun test ./server ./cardMaker/src",
    "typecheck": "bun run typecheck:server && bun run typecheck:client && bun run typecheck:cards",
    "typecheck:server": "bun --bun tsc --noEmit -p tsconfig.json",
    "typecheck:client": "bun --bun tsc --noEmit -p game-client/tsconfig.json",
    "typecheck:cards": "bun --bun tsc --noEmit -p cardMaker/tsconfig.json",
    "build": "bun run build:client && bun run build:cards",
    "build:client": "bun scripts/frontend.ts game-client build",
    "build:cards": "bun scripts/frontend.ts cardMaker build",
    "dev:client": "bun scripts/frontend.ts game-client dev",
    "dev:cards": "bun scripts/frontend.ts cardMaker dev",
    "ai:test": "bun test ./server/ai",
    "ai:tournament": "bun server/ai/run.ts",
    "vizdev:sync": "bun vizdev/sync-data.js",
    "vizdev:check": "bun vizdev/check-layout.js",
    "format": "bun scripts/control-flow.ts --fix && bun --bun prettier --write .",
    "format:check": "bun scripts/control-flow.ts && bun --bun prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "game-client",
    "cardMaker"
  ],
  "overrides": {
    "@types/react": "16.14.68",
    "@types/react-dom": "16.9.25",
    "@types/node": "^22.0.0"
  }
}
