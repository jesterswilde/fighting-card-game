{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "jsxFactory": "h",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "types": ["bun"],
    "paths": {
      "react-lightweight-tooltip": ["./src/tooltip.d.ts"]
    }
  },
  "include": ["index.tsx", "src/**/*.ts", "src/**/*.tsx", "*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
